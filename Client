
import java.io.*;
import java.net.*;

public class TCPClient {
    public static void main(String[] args) {
        try {
            Socket socket = new Socket("localhost", 5000);

            OutputStream out = socket.getOutputStream();
            out.write("hello_client".getBytes());
            out.close();

            socket.close();

        } catch (IOException e) {
            System.out.println(e.getMessage());
        }
    }
}
